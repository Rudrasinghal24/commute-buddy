# Server & CORS
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Nominatim / Photon / Overpass User-Agent Contact (REQUIRED for Phase 2+)
NOMINATIM_USER_AGENT=CommuteBuddy/1.0 (contact@example.com)
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commutebuddy
REDIS_URL=

# Routing & Traffic Providers
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
TRAFFIC_PROVIDER=tomtom
TOMTOM_API_KEY=
HERE_API_KEY=

# Transit & Verification Providers
TRANSIT_PROVIDER=gtfs_local
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_DAILY_CAP=500
OTD_DELHI_API_KEY=

# Licensed Train Providers
TRAIN_PRIMARY_PROVIDER=
TRAIN_PRIMARY_API_KEY=
TRAIN_SECONDARY_PROVIDER=
TRAIN_SECONDARY_API_KEY=

# Gemini AI Chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
